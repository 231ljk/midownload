#!/usr/bin/env bash
# Nx Programming Language - CLI Wrapper (Linux/macOS)
# Version: 0.1.0 (Developer Preview)
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INTERPRETER="$SCRIPT_DIR/nx_interpreter.py"

if command -v python3 &> /dev/null; then
    PYTHON=python3
elif command -v python &> /dev/null; then
    PYTHON=python
else
    echo "Error: Python 3 is required to run Nx."
    echo "Please install Python 3 from https://python.org"
    echo ""
    echo "  Ubuntu/Debian: sudo apt install python3"
    echo "  macOS:         brew install python3"
    echo "  CentOS/Fedora: sudo dnf install python3"
    exit 1
fi

if [ ! -f "$INTERPRETER" ]; then
    echo "Error: Nx interpreter not found at $INTERPRETER"
    echo "Please reinstall Nx."
    exit 1
fi

exec "$PYTHON" "$INTERPRETER" "$@"
