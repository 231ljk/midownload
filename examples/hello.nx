// ============================================================
// Nx Programming Language - Hello World & Feature Showcase
// Version: 0.1.0 (Developer Preview)
// ============================================================
//
// Nx 是一个全场景覆盖、双范式统一、AI 原生、全语言生态融合的编程语言。
// 本示例展示 Nx 的核心语法特性，可直接通过 `nx run hello.nx` 运行。
//

// --- 1. 基础语法：变量与函数 ---
app_name = "Nx Programming Language"
app_version = "0.1.0"
pi = 3.14159265359

func greet(name) {
    print("Hello, " + name + "! Welcome to " + app_name)
}

func add(a, b) {
    return a + b
}

func calculate_area(radius) {
    return pi * radius * radius
}

func factorial(n) {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

func fibonacci(n) {
    if n <= 1 { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

// --- 2. 控制流 ---
func classify_number(n) {
    if n > 0 {
        print(n + " is positive")
    } else if n < 0 {
        print(n + " is negative")
    } else {
        print(n + " is zero")
    }
}

func demonstrate_loops() {
    print("For loop (range):")
    for i in 0..5 {
        print("  i = " + i)
    }

    print("For loop (list):")
    fruits = ["apple", "banana", "cherry"]
    for fruit in fruits {
        print("  - " + fruit)
    }

    print("While loop:")
    count = 0
    while count < 3 {
        print("  count = " + count)
        count = count + 1
    }
}

// --- 3. 面向对象：类与继承 ---
class Shape {
    var name = "Shape"

    func init(name) {
        this.name = name
    }

    func area() {
        return 0
    }

    func describe() {
        print(this.name + " area = " + this.area())
    }
}

class Circle : Shape {
    var radius

    func init(radius) {
        super.init("Circle")
        this.radius = radius
    }

    func area() {
        return pi * this.radius * this.radius
    }
}

class Rectangle : Shape {
    var width
    var height

    func init(width, height) {
        super.init("Rectangle")
        this.width = width
        this.height = height
    }

    func area() {
        return this.width * this.height
    }
}

// --- 4. 数据类型与标准库 ---
func demonstrate_collections() {
    // 列表 (List)
    numbers = [1, 2, 3, 4, 5]
    print("List: " + numbers)
    print("Length: " + numbers.length)
    print("First element: " + numbers[0])
    numbers.append(6)
    print("After append: " + numbers)
    print("Sum: " + sum(numbers))
    print("Max: " + max(numbers))
    print("Min: " + min(numbers))

    // 字符串 (String)
    message = "Hello, Nx!"
    print("")
    print("String: " + message)
    print("Upper: " + message.upper())
    print("Lower: " + message.lower())
    print("Length: " + message.length)
    print("Contains 'Nx': " + message.contains("Nx"))

    // 字典 (Dict)
    person = {
        "name": "Alice",
        "age": 25,
        "city": "Beijing"
    }
    print("")
    print("Dict - Name: " + person["name"])
    print("Dict - Age: " + person["age"])
    print("Dict - Keys: " + person.keys())
}

// --- 5. 主函数 ---
func main() {
    print("========================================")
    print("  Nx Programming Language - Hello World")
    print("  v" + app_version + " - Developer Preview")
    print("========================================")
    print("")

    // 1. 基础语法
    print("--- 1. Basic Syntax ---")
    greet("Developer")
    print("10 + 5 = " + add(10, 5))
    print("Area of circle r=5: " + calculate_area(5))
    print("factorial(5) = " + factorial(5))
    print("fibonacci(10) = " + fibonacci(10))
    print("")

    // 2. 控制流
    print("--- 2. Control Flow ---")
    classify_number(42)
    classify_number(-7)
    classify_number(0)
    print("")
    demonstrate_loops()
    print("")

    // 3. 面向对象
    print("--- 3. OOP ---")
    circle = Circle(10)
    circle.describe()

    rect = Rectangle(4, 5)
    rect.describe()
    print("")

    // 4. 数据类型
    print("--- 4. Collections ---")
    demonstrate_collections()
    print("")

    print("========================================")
    print("  Nx program ran successfully!")
    print("  Full-stack | Dual-paradigm | AI-native")
    print("========================================")
}

// 运行主函数
main()
