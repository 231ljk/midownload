// ============================================================
// Nx Programming Language - Hello World & Feature Showcase
// Version: 0.1.0 (Developer Preview)
// ============================================================

// 基础语法 - 变量与函数
app_name = "Nx Programming Language"
app_version = "0.1.0"
pi = 3.14159265359

func greet(name) {
    print("Hello, " + name + "! Welcome to " + app_name)
}

func calculate_area(radius, unit = "cm") {
    area = pi * radius * radius
    return area
}

func sum(numbers...) {
    total = 0
    for n in numbers {
        total = total + n
    }
    return total
}

// 控制流
func classify_number(n) {
    if n > 0 {
        print(n + " is positive")
    } else if n < 0 {
        print(n + " is negative")
    } else {
        print(n + " is zero")
    }
}

func fibonacci(n) {
    if n <= 1 { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

// 面向对象 - 接口与类
interface Shape {
    func area() -> float
    func perimeter() -> float
}

class Circle : Shape {
    var radius
    var color = "red"

    func init(radius) {
        this.radius = radius
    }

    func area() {
        return pi * this.radius * this.radius
    }

    func perimeter() {
        return 2 * pi * this.radius
    }
}

class ColoredCircle : Circle {
    var border_width = 2

    func init(radius, color) {
        super.init(radius)
        this.color = color
    }

    func describe() {
        print("A " + this.color + " circle with radius " + this.radius)
    }
}

// 泛型类
class Stack[T] {
    var items = []

    func push(item: T) {
        this.items.append(item)
    }

    func pop() -> T {
        return this.items.pop()
    }
}

// 混入 Mixin
mixin Logger {
    func log(message) {
        print("[LOG] " + message)
    }
}

class Service with Logger {
    var name

    func init(name) {
        this.name = name
        this.log("Service " + name + " started")
    }
}

// 数据类型
func demonstrate_collections() {
    // List
    numbers = [1, 2, 3, 4, 5]
    numbers.append(6)
    print("List: " + numbers)
    print("First: " + numbers[0])

    // 列表推导式
    squares = [x * x for x in numbers]
    print("Squares: " + squares)

    // Dict
    person = {
        "name": "Alice",
        "age": 25,
        "skills": ["Nx", "Python", "Rust"]
    }
    print("Name: " + person["name"])

    // Tuple - 多返回值
    func get_user() {
        return ("Bob", 30, "Engineer")
    }
    name, age, job = get_user()
    print(name + " - " + age + " - " + job)

    // Set
    unique = {1, 2, 2, 3, 3, 3}
    print("Set: " + unique)
}

// 错误处理
func divide(a, b) {
    if b == 0 {
        throw Error("Division by zero")
    }
    return a / b
}

func demonstrate_error_handling() {
    try {
        result = divide(10, 0)
    } catch err {
        print("Caught error: " + err.message)
    } finally {
        print("Cleanup done")
    }
}

// 主函数
func main() {
    print("========================================")
    print("  Nx Programming Language - Hello World")
    print("  v0.1.0 - Developer Preview")
    print("========================================")
    print("")

    // 基础语法
    print("--- 1. Basic Syntax ---")
    greet("Developer")
    area = calculate_area(5)
    print("Area of circle r=5: " + area)
    print("Sum 1..5: " + sum(1, 2, 3, 4, 5))
    print("")

    // 控制流
    print("--- 2. Control Flow ---")
    classify_number(42)
    classify_number(-7)
    print("Fibonacci first 10:")
    for i in 0..10 {
        print("  fib(" + i + ") = " + fibonacci(i))
    }
    print("")

    // 面向对象
    print("--- 3. OOP ---")
    circle = Circle(10)
    print("Circle area: " + circle.area())
    print("Circle perimeter: " + circle.perimeter())

    colored = ColoredCircle(5, "blue")
    colored.describe()

    stack = Stack[int]()
    stack.push(1)
    stack.push(2)
    stack.push(3)
    print("Stack pop: " + stack.pop())

    service = Service("MyService")
    print("")

    // 数据类型
    print("--- 4. Collections ---")
    demonstrate_collections()
    print("")

    // 错误处理
    print("--- 5. Error Handling ---")
    demonstrate_error_handling()
    print("")

    print("========================================")
    print("  Nx program ran successfully!")
    print("  Full-stack | Dual-paradigm | AI-native")
    print("========================================")
}

main()
